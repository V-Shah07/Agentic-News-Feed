# Copy to .env and fill in. Secrets are never committed.
DATABASE_URL=postgresql+psycopg2://newsuser:newspass@localhost:5432/newsfeed
REDIS_URL=redis://localhost:6379/0

CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_PERSIST_DIR=./chroma_data

EMBEDDING_MODEL=all-MiniLM-L6-v2
NOVELTY_THRESHOLD=0.85
NOVELTY_WINDOW_DAYS=30

# Required for Phase 4/5 (LLM cluster summaries + RAG synthesis)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

INGEST_INTERVAL_SECONDS=3600
INGEST_PER_SOURCE_LIMIT=20

MLFLOW_TRACKING_URI=./mlruns
